generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Job {
  id        String   @id @default(cuid())
  status    JobStatus @default(IN_PROGRESS)
  createdAt DateTime @default(now())

  /// Salted SHA-256 of the client IP, used only to rate limit. The raw address
  /// is never stored, so this cannot be read back as an identifier.
  clientHash String?

  primaryFile   Bytes?
  secondaryFile Bytes?
  jobMessages   JobMessage[]

  @@index([createdAt])
  @@index([clientHash, createdAt])
}

enum JobStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED
  FAILED
}

model JobMessage {
  id        String   @id @default(cuid())
  jobId     String
  createdAt DateTime @default(now())
  message   String
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
